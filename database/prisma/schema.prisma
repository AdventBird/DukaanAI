generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  CASHIER
  ASSISTANT
}

model Store {
  id                    String                 @id @default(uuid())
  name                  String
  currency              String                 @default("INR")
  timezone              String                 @default("Asia/Kolkata")
  isDemo                Boolean                @default(false)
  users                 User[]
  expenses              Expense[]
  events                OutboxEvent[]
  auditLogs             AuditLog[]
  categories            Category[]
  products              Product[]
  productBarcodes       ProductBarcode[]
  inventoryBalances     InventoryBalance[]
  stockMovements        StockMovement[]
  sales                 Sale[]
  payments              Payment[]
  suppliers             Supplier[]
  supplierProducts      SupplierProduct[]
  quoteRequests         QuoteRequest[]
  quoteRequestSuppliers QuoteRequestSupplier[]
  supplierQuotes        SupplierQuote[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  invoices              PurchaseInvoice[]
  agentTasks            AgentTask[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model User {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  displayName String
  loginId     String
  role        UserRole @default(OWNER)
  authSubject String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, loginId])
  @@index([storeId, role])
  @@index([authSubject])
}

model Expense {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  occurredAt  DateTime
  createdById String
  createdAt   DateTime @default(now())

  @@index([storeId, occurredAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
}

model OutboxEvent {
  id             String    @id @default(uuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  eventType      String
  payloadVersion Int       @default(1)
  entityType     String
  entityId       String
  payload        Json
  occurredAt     DateTime  @default(now())
  processedAt    DateTime?
  attempts       Int       @default(0)
  lastError      String?
  createdAt      DateTime  @default(now())

  @@index([processedAt, createdAt])
  @@index([storeId, createdAt])
}

// ==========================================
// Product & Inventory Domain Models (Dev 1)
// ==========================================

enum StockUnit {
  PIECE
  KG
  GRAM
  LITRE
  MILLILITRE
  PACKET
  BOX
}

enum StockMovementType {
  OPENING
  SALE
  PURCHASE_RECEIPT
  MANUAL_ADJUSTMENT
  DAMAGE
  EXPIRY
  CUSTOMER_RETURN
  REVERSAL
}

model Category {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, name])
  @@index([storeId])
}

model Product {
  id                   String    @id @default(uuid())
  storeId              String
  sku                  String?
  name                 String
  brand                String?
  categoryId           String
  description          String?
  stockUnit            StockUnit @default(PIECE)
  purchasePackLabel    String? // e.g. "Carton (12 pcs)", "Bag (25 kg)"
  unitsPerPurchasePack Decimal?  @db.Decimal(12, 3) // Factor to convert purchase pack into stockUnit
  mrp                  Decimal?  @db.Decimal(10, 2)
  sellingPrice         Decimal   @db.Decimal(10, 2)
  purchaseCost         Decimal?  @db.Decimal(10, 2)
  reorderLevel         Decimal   @default(0) @db.Decimal(12, 3)
  targetStockLevel     Decimal?  @default(0) @db.Decimal(12, 3)
  isActive             Boolean   @default(true) // Soft archive
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category         Category          @relation(fields: [categoryId], references: [id])
  barcodes         ProductBarcode[]
  inventoryBalance InventoryBalance?
  stockMovements   StockMovement[]
  saleItems        SaleItem[]
  supplierProducts SupplierProduct[]

  @@unique([storeId, sku])
  @@index([storeId, isActive])
  @@index([storeId, categoryId])
  @@index([storeId, name])
}

model ProductBarcode {
  id        String   @id @default(uuid())
  storeId   String
  productId String
  barcode   String // String type to strictly preserve leading zeros
  symbology String? // EAN-13, EAN-8, UPC-A, etc.
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, barcode])
  @@index([storeId, productId])
}

model InventoryBalance {
  id             String   @id @default(uuid())
  storeId        String
  productId      String   @unique
  quantityOnHand Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt      DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([storeId])
}

model StockMovement {
  id             String            @id @default(uuid())
  storeId        String
  productId      String
  movementType   StockMovementType
  quantityDelta  Decimal           @db.Decimal(12, 3) // Signed: Positive = added, Negative = deducted
  unit           String // Snapshot of unit
  reason         String? // Mandatory for manual adjustments
  referenceType  String? // e.g. "SALE", "PURCHASE_RECEIPT", "STOCKTAKE"
  referenceId    String? // saleId, goodsReceiptId, etc.
  idempotencyKey String?           @unique // Prevents duplicate updates
  actorType      String? // "OWNER", "STAFF", "SYSTEM", "AI"
  actorId        String?
  createdAt      DateTime          @default(now()) // Strictly append-only

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, productId, createdAt])
  @@index([storeId, movementType])
  @@index([idempotencyKey])
}

// ==========================================
// Sales & POS Domain Models (Dev 2)
// ==========================================

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
}

model Sale {
  id             String        @id @default(uuid())
  storeId        String
  receiptNumber  String
  status         SaleStatus    @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paymentStatus  PaymentStatus @default(COMPLETED)
  paymentMethod  PaymentMethod @default(CASH)
  amountPaid     Decimal       @db.Decimal(12, 2)
  changeDue      Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal       @default(0) @db.Decimal(12, 2)
  customerLabel  String?
  idempotencyKey String        @unique
  createdBy      String        @default("cashier")
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items    SaleItem[]
  payments Payment[]

  @@unique([storeId, receiptNumber])
  @@index([storeId, createdAt])
  @@index([storeId, paymentMethod])
  @@index([idempotencyKey])
}

model SaleItem {
  id                  String   @id @default(uuid())
  saleId              String
  productId           String
  productNameSnapshot String
  barcodeSnapshot     String?
  stockUnitSnapshot   String
  quantity            Decimal  @db.Decimal(12, 3)
  unitPriceSnapshot   Decimal  @db.Decimal(12, 2)
  unitCostSnapshot    Decimal? @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id         String        @id @default(uuid())
  storeId    String
  saleId     String
  method     PaymentMethod
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(COMPLETED)
  reference  String?
  occurredAt DateTime      @default(now())
  recordedBy String        @default("cashier")
  createdAt  DateTime      @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale  Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([storeId, occurredAt])
  @@index([saleId])
}

// ==========================================
// Supplier & Procurement Domain (Dev 3)
// ==========================================

model Supplier {
  id                     String                 @id @default(uuid())
  storeId                String
  name                   String
  legalName              String?
  contactPerson          String?
  phone                  String
  whatsappPhone          String?
  email                  String?
  address                String?
  city                   String?
  state                  String?
  pincode                String?
  preferredContactMethod String                 @default("PHONE")
  defaultLeadTimeDays    Int?
  defaultPaymentTerms    String?
  notes                  String?
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  store                  Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products               SupplierProduct[]
  quotes                 SupplierQuote[]
  quoteRequests          QuoteRequestSupplier[]
  purchaseOrders         PurchaseOrder[]

  @@unique([storeId, id])
  @@index([storeId, isActive, createdAt])
  @@index([storeId, name])
}

model SupplierProduct {
  id                   String   @id @default(uuid())
  storeId              String
  supplierId           String
  productId            String
  supplierSku          String?
  purchaseUnitLabel    String
  unitsPerPurchasePack Decimal  @db.Decimal(12, 3)
  minimumOrderQuantity Decimal  @default(1) @db.Decimal(12, 3)
  lastQuotedPrice      Decimal? @db.Decimal(12, 2)
  leadTimeDays         Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier             Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([storeId, supplierId, productId])
  @@index([storeId, productId, isActive])
}

model QuoteRequest {
  id            String                 @id @default(uuid())
  storeId       String
  requestNumber String
  status        String                 @default("SENT")
  requestedById String
  notes         String?
  sentAt        DateTime               @default(now())
  createdAt     DateTime               @default(now())
  store         Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  suppliers     QuoteRequestSupplier[]
  items         QuoteRequestItem[]
  quotes        SupplierQuote[]

  @@unique([storeId, requestNumber])
  @@index([storeId, createdAt])
}

model QuoteRequestSupplier {
  id             String       @id @default(uuid())
  storeId        String
  quoteRequestId String
  supplierId     String
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([quoteRequestId, supplierId])
  @@index([storeId, supplierId])
}

model QuoteRequestItem {
  id                       String       @id @default(uuid())
  quoteRequestId           String
  productId                String
  productName              String
  requestedQuantityInPacks Decimal      @db.Decimal(12, 3)
  purchaseUnitLabel        String
  unitsPerPackSnapshot     Decimal      @db.Decimal(12, 3)
  notes                    String?
  quoteRequest             QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
}

model SupplierQuote {
  id                   String              @id @default(uuid())
  storeId              String
  supplierId           String
  quoteRequestId       String?
  supplierName         String
  quoteReference       String?
  status               String              @default("RECEIVED")
  source               String
  sourceReference      String?
  deliveryCharge       Decimal             @default(0) @db.Decimal(12, 2)
  otherCharges         Decimal             @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal             @default(0) @db.Decimal(12, 2)
  quotedAt             DateTime            @default(now())
  validUntil           DateTime?
  expectedDeliveryDate DateTime?
  leadTimeDays         Int?
  notes                String?
  createdAt            DateTime            @default(now())
  store                Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  quoteRequest         QuoteRequest?       @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  items                SupplierQuoteItem[]
  purchaseOrders       PurchaseOrder[]

  @@index([storeId, supplierId, createdAt])
  @@index([storeId, quoteRequestId])
}

model SupplierQuoteItem {
  id                            String        @id @default(uuid())
  supplierQuoteId               String
  productId                     String
  quotedProductNameSnapshot     String
  supplierSkuSnapshot           String?
  quotedQuantityInPurchasePacks Decimal       @db.Decimal(12, 3)
  purchaseUnitLabelSnapshot     String
  unitsPerPackSnapshot          Decimal       @db.Decimal(12, 3)
  unitPricePerPurchasePack      Decimal       @db.Decimal(12, 2)
  lineDiscount                  Decimal       @default(0) @db.Decimal(12, 2)
  freeStockUnits                Decimal       @default(0) @db.Decimal(12, 3)
  isAvailable                   Boolean       @default(true)
  createdAt                     DateTime      @default(now())
  supplierQuote                 SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)

  @@index([supplierQuoteId, productId])
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  storeId              String
  orderNumber          String
  supplierId           String
  supplierName         String
  supplierQuoteId      String?
  status               String              @default("DRAFT")
  revision             Int                 @default(1)
  currency             String              @default("INR")
  subtotal             Decimal             @db.Decimal(12, 2)
  discountTotal        Decimal             @db.Decimal(12, 2)
  chargesTotal         Decimal             @db.Decimal(12, 2)
  estimatedTotal       Decimal             @db.Decimal(12, 2)
  expectedDeliveryDate DateTime?
  paymentTermsSnapshot String?
  notes                String?
  createdById          String
  approvedById         String?
  approvedAt           DateTime?
  approvalNote         String?
  rejectionReason      String?
  submittedAt          DateTime?
  supplierReference    String?
  acknowledgedAt       DateTime?
  receivedAt           DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  idempotencyKey       String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  store                Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierQuote        SupplierQuote?      @relation(fields: [supplierQuoteId], references: [id], onDelete: SetNull)
  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]
  invoices             PurchaseInvoice[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
  @@index([storeId, supplierId])
}

model PurchaseOrderItem {
  id                             String             @id @default(uuid())
  purchaseOrderId                String
  productId                      String
  productNameSnapshot            String
  supplierSkuSnapshot            String?
  orderedQuantityInPurchasePacks Decimal            @db.Decimal(12, 3)
  purchaseUnitLabelSnapshot      String
  unitsPerPackSnapshot           Decimal            @db.Decimal(12, 3)
  orderedQuantityInStockUnits    Decimal            @db.Decimal(12, 3)
  unitPricePerPurchasePack       Decimal            @db.Decimal(12, 2)
  lineDiscount                   Decimal            @default(0) @db.Decimal(12, 2)
  lineTotal                      Decimal            @db.Decimal(12, 2)
  receivedQuantityInStockUnits   Decimal            @default(0) @db.Decimal(12, 3)
  purchaseOrder                  PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receipts                       GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id                    String             @id @default(uuid())
  storeId               String
  purchaseOrderId       String
  receiptNumber         String
  status                String             @default("DRAFT")
  deliveredAt           DateTime           @default(now())
  verifiedAt            DateTime?
  verifiedById          String?
  deliveryNoteReference String?
  notes                 String?
  idempotencyKey        String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  store                 Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrder         PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items                 GoodsReceiptItem[]

  @@unique([storeId, receiptNumber])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, purchaseOrderId, createdAt])
}

model GoodsReceiptItem {
  id                               String            @id @default(uuid())
  goodsReceiptId                   String
  purchaseOrderItemId              String
  productId                        String
  deliveredQuantityInPurchasePacks Decimal           @db.Decimal(12, 3)
  acceptedQuantityInStockUnits     Decimal           @db.Decimal(12, 3)
  damagedQuantityInStockUnits      Decimal           @default(0) @db.Decimal(12, 3)
  rejectedQuantityInStockUnits     Decimal           @default(0) @db.Decimal(12, 3)
  shortQuantityInStockUnits        Decimal           @default(0) @db.Decimal(12, 3)
  excessQuantityInStockUnits       Decimal           @default(0) @db.Decimal(12, 3)
  purchaseUnitLabelSnapshot        String
  unitsPerPackSnapshot             Decimal           @db.Decimal(12, 3)
  discrepancyReason                String?
  condition                        String?
  notes                            String?
  goodsReceipt                     GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem                PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
}

model PurchaseInvoice {
  id                  String                @id @default(uuid())
  storeId             String
  purchaseOrderId     String
  invoiceNumber       String
  invoiceDate         DateTime
  totalInvoicedAmount Decimal               @db.Decimal(12, 2)
  fileReference       String?
  notes               String?
  createdAt           DateTime              @default(now())
  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrder       PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items               PurchaseInvoiceItem[]

  @@unique([storeId, invoiceNumber])
  @@index([storeId, purchaseOrderId])
}

model PurchaseInvoiceItem {
  id                   String          @id @default(uuid())
  invoiceId            String
  productId            String
  invoicedPacks        Decimal         @db.Decimal(12, 3)
  invoicedPricePerPack Decimal         @db.Decimal(12, 2)
  invoicedTotal        Decimal         @db.Decimal(12, 2)
  invoice              PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, productId])
}

model AgentTask {
  id                String    @id
  storeId           String
  taskType          String
  status            String    @default("QUEUED")
  relatedEntityType String?
  relatedEntityId   String?
  inputSummary      String
  currentStep       Int       @default(0)
  steps             Json
  checkpoint        Json
  attemptCount      Int       @default(0)
  maxAttempts       Int       @default(3)
  nextRunAt         DateTime?
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  lastErrorCode     String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status, createdAt])
  @@index([storeId, relatedEntityType, relatedEntityId])
}
