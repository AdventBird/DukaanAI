generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  CASHIER
  ASSISTANT
}

model Store {
  id        String      @id @default(uuid())
  name      String
  currency  String      @default("INR")
  timezone  String      @default("Asia/Kolkata")
  isDemo    Boolean     @default(false)
  users     User[]
  expenses  Expense[]
  events    OutboxEvent[]
  auditLogs AuditLog[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model User {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  displayName String
  loginId   String
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([storeId, loginId])
  @@index([storeId, role])
}

model Expense {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  occurredAt  DateTime
  createdById String
  createdAt   DateTime @default(now())
  @@index([storeId, occurredAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([storeId, createdAt])
}

model OutboxEvent {
  id             String   @id @default(uuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  eventType      String
  payloadVersion Int      @default(1)
  entityType     String
  entityId       String
  payload        Json
  occurredAt     DateTime @default(now())
  processedAt    DateTime?
  attempts       Int      @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  @@index([processedAt, createdAt])
  @@index([storeId, createdAt])
}
