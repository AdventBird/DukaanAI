NODE_ENV=development
PORT=3001
# API runtime connection. Use a least-privilege PostgreSQL role; for a persistent
# Express server use Supabase Direct (IPv6) or Session pooler (IPv4-only).
DATABASE_URL=postgresql://dukaanai:dukaanai@localhost:5432/dukaanai?schema=public
# Prisma CLI migration connection. Keep this separate and use a direct or
# session-mode connection with migration privileges. Never expose it to the web.
DIRECT_URL=postgresql://dukaanai:dukaanai@localhost:5432/dukaanai?schema=public
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001/api
# Local shortcut only. Set to a non-demo value when using Supabase Auth.
AUTH_MODE=demo
SESSION_SECRET=replace-for-local-development
# Backend identity verification values. The anon/publishable key is not a secret,
# but keep server credentials server-side. No service-role key is used by this API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Intended browser values; current web app does not yet implement Supabase sign-in.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Only for the explicit isolated RLS preflight; all four values are required
# when running npm run test:rls --workspace @dukaanai/api.
# RLS_TEST_DATABASE_URL=
# RLS_TEST_STORE_A_ID=
# RLS_TEST_STORE_B_ID=
# RLS_TEST_SUBJECT_A=
# Optional and intentionally blank. AI functionality remains unavailable without a
# provider credential supplied through the local environment or deployment secret store.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
